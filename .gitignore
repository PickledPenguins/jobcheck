__pycache__/
*.py[cod]
.venv/
build/
dist/
*.egg-info/

# Every generated artifact lives under .build/ so the project root shows only
# files a reader is looking for: the coverage data, the pytest and mypy caches,
# the hypothesis database, the profile and the performance baseline.
.build/

# mutmut hardcodes Path('mutants') relative to the working directory, so this
# one cannot be moved under .build/. It is transient: delete it after a run.
mutants/
.mutmut-cache

# Agent working files: saved review reports, written by creview and cleared by
# caddressreview. The handoff record beside them is tracked.
.agent/reviews/
